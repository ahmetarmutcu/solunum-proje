{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python",
      "config": { "runtime": "python3.12" }
    }
  ],
  "functions": {
    "main.py": {
      "excludeFiles": "{data/**,results/**,temp_audio/**,inference/**,database.db}"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "main.py"
    }
  ]
}